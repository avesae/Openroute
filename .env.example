# Скопируйте этот файл в .env.local и заполните нужные значения.
# Все переменные необязательны: без них сайт работает, просто соответствующая функция выключена.

# Адрес сайта (для canonical, sitemap, Open Graph). Без слэша в конце.
NEXT_PUBLIC_SITE_URL=https://openroute.example

# ── Заявки на email (https://resend.com) ──
# Без ключа заявки пишутся в лог сервера.
RESEND_API_KEY=
LEAD_EMAIL_TO=manager@your-domain.fi
# Адрес отправителя — домен должен быть подтверждён в Resend
LEAD_EMAIL_FROM=Openroute <noreply@your-domain.fi>

# ── AI-ассистент (https://console.anthropic.com) ──
# Без ключа кнопка чата не показывается.
ANTHROPIC_API_KEY=
# Модель (необязательно). По умолчанию claude-opus-5-5.
# Для экономии можно указать claude-sonnet-5-5 или claude-haiku-5-5.
ANTHROPIC_MODEL=

# ── Google Analytics 4 ──
# Загружается только после согласия посетителя в cookie-баннере.
NEXT_PUBLIC_GA_ID=
