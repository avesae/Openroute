# Скопируйте этот файл в .env.local и заполните нужные значения.
# Все переменные необязательны: без них сайт работает, просто соответствующая функция выключена.

# Адрес сайта (для canonical, sitemap, Open Graph). Без слэша в конце.
NEXT_PUBLIC_SITE_URL=https://openroute.example

# ── Заявки на почту через SMTP российского почтового сервиса ──
# Например, Яндекс 360: smtp.yandex.ru, порт 465, логин — адрес ящика, пароль — пароль приложения.
# Без SMTP_HOST заявки и журнал согласий пишутся в лог сервера.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=manager@your-domain.ru
LEAD_EMAIL_FROM=Openroute <noreply@your-domain.ru>

# ── ИИ-ассистент (любой OpenAI-совместимый API) ──
# Без ключа кнопка чата не показывается. Сообщения посетителей уходят провайдеру модели:
# для 152-ФЗ выбирайте провайдера с серверами в РФ или предупредите о трансграничной передаче в политике.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ── Яндекс Метрика ──
# Номер счётчика (только цифры). Загружается только после согласия посетителя на аналитические cookie.
NEXT_PUBLIC_YM_ID=
